{$APP_DOMAIN:http://localhost} {
  encode zstd gzip

  handle /api/auth/* {
    reverse_proxy auth-service:8081
  }

  handle /api/v1/* {
    reverse_proxy order-service:8080
  }

  handle /orders* {
    reverse_proxy order-service:8080
  }

  handle /api/geocode* {
    reverse_proxy order-service:8080
  }

  handle /api/route* {
    reverse_proxy order-service:8080
  }

  handle /health {
    reverse_proxy auth-service:8081
  }

  handle {
    reverse_proxy frontend:80
  }
}
